# JARVIS Environment Configuration
# Copy this to .env and fill in your values

# ═══════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════
APP_NAME=JARVIS
APP_VERSION=1.0.0
APP_ENV=development           # development | production
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/jarvis.log

# ═══════════════════════════════════════════════
# API Server Settings
# ═══════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8765
API_WORKERS=1
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ═══════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
REQUIRE_AUTH=true
ALLOWED_IPS=[]                # Empty = all IPs allowed

# ═══════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jarvis

# ═══════════════════════════════════════════════
# AI / LLM Settings
# ═══════════════════════════════════════════════
AI_PROVIDER=ollama            # ollama | openai | auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60
OPENAI_API_KEY=               # optional
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_SYSTEM_PROMPT=You are JARVIS, an advanced AI assistant. You help control a Fedora Linux desktop. Be concise, accurate, and professional.
MEMORY_MAX_TURNS=20

# ═══════════════════════════════════════════════
# Voice Settings
# ═══════════════════════════════════════════════
VOICE_ENABLED=true
WAKE_WORD=jarvis
WAKE_WORD_THRESHOLD=0.7
STT_PROVIDER=faster-whisper   # faster-whisper | openai-whisper
STT_MODEL=base.en             # tiny | base | small | medium | large
STT_DEVICE=cpu                # cpu | cuda
TTS_PROVIDER=piper            # piper | espeak | none
PIPER_MODEL=en_US-lessac-medium
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# MIC_INDEX=                  # Uncomment and set to override default mic device index

# ═══════════════════════════════════════════════
# Notifications
# ═══════════════════════════════════════════════
NOTIFICATIONS_ENABLED=true
DISCORD_TOKEN=
DISCORD_GUILD_ID=
GITHUB_TOKEN=
GITHUB_REPOS=[]
GMAIL_CREDENTIALS_FILE=
BATTERY_WARNING_THRESHOLD=20  # percent

# ═══════════════════════════════════════════════
# System Monitoring
# ═══════════════════════════════════════════════
MONITOR_INTERVAL=5            # seconds
CPU_ALERT_THRESHOLD=90        # percent
RAM_ALERT_THRESHOLD=90        # percent
DISK_ALERT_THRESHOLD=90       # percent
TEMP_ALERT_THRESHOLD=80       # celsius

# ═══════════════════════════════════════════════
# Weather
# ═══════════════════════════════════════════════
WEATHER_API_KEY=
WEATHER_CITY=

# ═══════════════════════════════════════════════
# Plugins
# ═══════════════════════════════════════════════
PLUGINS_ENABLED=true
PLUGINS_DIR=plugins/installed
PLUGIN_SANDBOX=true
